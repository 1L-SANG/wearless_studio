            {
              "role": "items.1",
              "text": "출근할 때도 주말에도 편하게 입고 싶은 분"
            },
            {
              "role": "items.2",
              "text": "다리에 딱 붙는 바지가 불편하신 분"
            },
            {
              "role": "items.3",
              "text": "과한 워싱 없이 깔끔한 데님을 원하시는 분"
            }
