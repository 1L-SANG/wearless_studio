    "response": {
      "sections": [
        {
          "key": "first",
          "texts": [
            {
              "role": "label",
              "text": "Stripe Shirt"
            }
          ]
        },
        {
          "key": "review",
          "texts": [
            {
              "role": "items.0.text",
              "text": "잔잔한 파란 줄무늬가 깔끔해서 출근할 때 자주 입게 돼요"
            },
            {
              "role": "items.1.text",
              "text": "품이 여유로워 편함"
            },
            {
              "role": "items.2.text",
              "text": "맨살에 닿아도 부드러워서 입기 좋아요"
            }
          ]
        },
        {
          "key": "intro",
          "texts": [
            {
              "role": "title",
              "text": "단정하고 여유로운 면 셔츠"
            },
            {
              "role": "body",
              "text": "여유 있는 세미 오버핏으로 편하게 입기 좋은 스트라이프 셔츠예요\n단독으로 입어도 깔끔하고 가디건이나 니트 조끼 안에 받쳐 입기도 좋아요\n청바지와 함께 데일리룩으로 가볍게 매치해 보세요"
            }
          ]
        },
        {
          "key": "for_you",
          "texts": [
            {
              "role": "items.0",
              "text": "답답하게 조이지 않는 셔츠를 찾는 분"
            },
            {
              "role": "items.1",
              "text": "가디건이나 조끼 안에 받쳐 입을 옷이 필요한 분"
            },
            {
              "role": "items.2",
              "text": "청바지에 가볍게 걸칠 상의를 찾는 분"
            },
            {
              "role": "items.3",
              "text": "출근할 때 단정하게 입을 셔츠가 필요한 분"
            }
          ]
        },
        {
          "key": "fabric",
          "texts": [
            {
              "role": "title",
              "text": "부드럽고 탄탄한 면 소재"
            },
            {
              "role": "body",
              "text": "피부에 거슬림 없이 닿아서 하루 종일 입고 있어도 편안해요"
            }
          ]
        },
        {
          "key": "faq",
          "texts": [
            {
              "role": "items.0.q",
              "text": "품이 많이 넉넉한 편인가요?"
            },
            {
              "role": "items.0.a",
              "text": "세미 오버핏으로 여유 있게 나왔어요. 정확한 치수는 하단 사이즈표를 확인해 주세요."
            },
            {
              "role": "items.2.q",
              "text": "세탁은 어떻게 해야 하나요?"
            },
            {
              "role": "items.2.a",
              "text": "약간의 수축이 생길 수 있어서 찬물에 단독으로 빨고 건조기 사용은 피해주세요."
            }
          ]
        }
      ],
      "partDescriptionCopy": [
        {
          "point": "소맷단 단추",
          "desc": "소매 끝에 단추가 2개 있어서\n손목에 맞게 잠그기 좋아요"
        },
        {
          "point": "세로 줄무늬",
          "desc": "가는 파란 줄무늬가 들어가서\n단독으로 입어도 심심하지 않아요"
        }
      ],
      "featureCopy": [
        {
          "point": "소매 단추",
          "desc": "단추를 풀어 소매를 가볍게 걷어 올릴 때도 흘러내리지 않고 편해요"
        }
      ]
    }
