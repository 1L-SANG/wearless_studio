    "response": {
      "sections": [
        {
          "key": "first",
          "texts": [
            {
              "role": "label",
              "text": "Pintuck Puff Blouse"
            }
          ]
        },
        {
          "key": "review",
          "texts": [
            {
              "role": "items.0.text",
              "text": "스커트에 맞춰 입으니 단정하고 예뻐요"
            },
            {
              "role": "items.1.text",
              "text": "소매가 참 귀엽네요"
            },
            {
              "role": "items.2.text",
              "text": "너무 두껍지 않고 가벼워서 봄가을에 입기 딱 좋습니다"
            }
          ]
        },
        {
          "key": "intro",
          "texts": [
            {
              "role": "title",
              "text": "팔뚝이 편한 단정한 블라우스"
            },
            {
              "role": "body",
              "text": "소매가 봉긋해서 팔뚝이 달라붙지 않아\n편하게 입기 좋은 핀턱 퍼프 블라우스예요"
            }
          ]
        },
        {
          "key": "for_you",
          "texts": [
            {
              "role": "items.0",
              "text": "팔뚝에 옷이 달라붙는 게 신경 쓰이는 분"
            },
            {
              "role": "items.1",
              "text": "슬랙스에 받쳐 입을 출근용 상의를 찾는 분"
            },
            {
              "role": "items.2",
              "text": "밋밋한 기본 셔츠보다 가벼운 변화를 원하는 분"
            },
            {
              "role": "items.3",
              "text": "가디건 안에 단정하게 입을 옷이 필요한 분"
            }
          ]
        },
        {
          "key": "fabric",
          "texts": [
            {
              "role": "title",
              "text": "부드럽고 매끈한 레이온 혼방"
            },
            {
              "role": "body",
              "text": "피부에 닿는 감촉이 까끌거리지 않고 가벼워서 하루 종일 입고 있어도 편안해요"
            }
          ]
        },
        {
          "key": "faq",
          "texts": [
            {
              "role": "items.0.q",
              "text": "사이즈는 어떻게 고르면 될까요?"
            },
            {
              "role": "items.0.a",
              "text": "품이 적당한 레귤러핏이라 평소 사이즈로 고르시고 상세 실측표를 확인해 주세요"
            },
            {
              "role": "items.1.q",
              "text": "어느 계절에 입기 좋은가요?"
            },
            {
              "role": "items.1.a",
              "text": "가벼운 레이온 혼방 원단이라 봄가을에는 하나만 입고 쌀쌀할 땐 겉옷 안에 입기 좋아요"
            },
            {
              "role": "items.2.q",
              "text": "원단이 잘 늘어나는 편인가요?"
            },
            {
              "role": "items.2.a",
              "text": "스판이 없는 원단이라 늘어나진 않지만 품이 적당해서 움직이기 불편하지 않아요"
            }
          ]
        }
      ],
      "partDescriptionCopy": [
        {
          "point": "퍼프 소매",
          "desc": "어깨 쪽에 여유가 있어서\n팔을 움직일 때 조이지 않고 편해요"
        },
        {
          "point": "앞 핀턱",
          "desc": "가운데에 세로로 잔주름이 잡혀 있어서\n하나만 입어도 밋밋하지 않아요"
        }
      ],
      "featureCopy": [
        {
          "point": "퍼프 소매",
          "desc": "소매 통이 봉긋하게 살아 있어서 팔뚝이 부각되지 않고 귀여운 느낌을 줘요"
        },
        {
          "point": "앞 핀턱",
          "desc": "스커트나 바지에 넣어 입거나 가디건을 걸쳐도 앞모습이 단정해 보여요"
        }
      ]
    }
  },
