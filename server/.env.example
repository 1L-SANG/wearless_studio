# Wearless Studio API — Phase 0 환경 변수
# 프로덕션(AWS)은 copilot/api/manifest.yml variables(평문) + SSM Parameter Store(secret)에 등록한다.

APP_ENV=dev                      # dev | production
SUPABASE_URL=                    # https://<project-ref>.supabase.co
# SUPABASE_JWKS_URL=             # 기본값: $SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173,https://ai.wearless.kr

# DB 직접 연결 (마이그레이션 적용 — Session pooler URI, 비밀번호 percent-encode)
DATABASE_URL=                    # postgresql://postgres.<ref>:<pw>@...pooler.supabase.com:5432/postgres
# Supabase API 키 (대시보드 Settings → API). Phase 1 서버 쓰기에 필요.
SUPABASE_ANON_KEY=               # publishable — 공개 가능
SUPABASE_SERVICE_ROLE_KEY=       # secret — 서버 전용, 절대 프론트/채팅 노출 금지

# R2 (Cloudflare, S3 호환) — 자산 저장 (§3). secret 등급, 서버 전용(AWS/SSM). 프론트(Vercel) 금지.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=            # 한 번만 표시됨 — 잘 저장
R2_BUCKET=                       # 예: wearless-assets
R2_ENDPOINT=                     # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE=                  # 커스텀 도메인 예: https://images.wearless.kr (없으면 signed GET 폴백)
# 배경-only 생성예시. 기본 false; 프론트 VITE_GENEXAMPLE_BG_ENABLED와 함께 명시적으로 켠다.
GENEXAMPLE_BG_ENABLED=false

# FaceMarket VC — 프로덕션 FaceMarket은 true + private Holder URL/HMAC secret 모두 필수.
FACEMARKET_VC_REQUIRED=false
OPENDID_HOLDER_URL=
OPENDID_HOLDER_HMAC_SECRET=

# --- AI 에이전트 (Phase 4) ---
GEMINI_API_KEY=                  # AI Studio AIza… (서버 전용, secret)
OPENAI_API_KEY=                  # GPT Image 2 상세컷 경로(서버 전용, secret)
MANNEQUIN_BASE_WOMEN_ASSET_ID=   # R2 시드 베이스 마네킹 asset id (startup 검증)
                                 # 여성 정본 = base-women-2K.png(원본). 다리 단축본 v2 실험은
                                 # 착장컷 비교에서 밀려 폐기(shorten_base_legs.py 에 경위).
MANNEQUIN_BASE_MEN_ASSET_ID=
# Pillow QC 게이팅 — false=shadow(로그만). 2026-07-04 캘리브레이션(scripts/qc_calibrate.py) 통과로 true 였으나,
# 실모델(Gemini 3 Pro) 출력 전건 거부 이슈로 2026-07-07부터 프로덕션 false(shadow) 운영(커밋 7ce5a68).
# 게이팅 재활성화 전 반드시 qc_calibrate 재실행(게이트: 정상 차단 0건) 후 반영.
MANNEQUIN_QC_ENABLED=false
# 셀러 강조특징 정규화 (FR-D1) — off=원문 그대로 | shadow=원문+매핑 로그 | enforce=canonical 큐만·미매칭 폐기
SELLER_TEXT_CANONICALIZE=off
# 매칭 랭킹 (FR-A) — off=규칙(밝기순) | tags=styleTags 친화도 v1. 프론트가 styleTags 넘겨야 tags 동작.
RETRIEVAL_MATCHING=tags
# 정적 지식블록 주입 (FR-B/2a) — off=미적용 | static=카테고리·styleTags 큐레이션 가이드.
RETRIEVAL_KNOWLEDGE=off
# 입력측 업로드 QC (FR-D4) — off=미적용 | shadow=로그만 | enforce=손상·저해상 사진 거부(400). 기본 off.
INPUT_QC=off

# ---- AG-01 분석 속도/품질 (2026-07-07) — 전부 선택(기본값 있음) ----
ANALYSIS_MODEL_ORDER=gemini,gpt       # provider 폴백 순서
ANALYSIS_THINKING_LEVEL=low           # Gemini thinking: low(기본, 분류엔 충분·빠름) | medium | high | off(모델 기본)
# 입력 사진 동일성(AG-IC) — 셀러가 올린 사진 중 다른 옷이 섞였는지. 분석 잡에 얹혀 도는
# 관찰 축이라 추가 지연이 없다. off | warn(생성 직전 모달, 기본).
# enforce 값은 없다 — 이 판정은 아무것도 막지 않는다(경고에도 "계속 진행"이 항상 열려 있다).
# shadow 도 없다 — 읽을 사람이 정해지지 않은 기록은 호출 비용만 쓴다(2026-08-02 오너 결정).
# 오탐이 잦으면: INPUT_CONSISTENCY=off 로 즉시 무력화(재배포 불필요), 또는
# input_consistency.MIN_MISMATCH_CONFIDENCE 상향. 오프라인 평가는 scripts/ic_calibrate.py.
INPUT_CONSISTENCY=warn

# QC 게이팅. off|shadow 는 관측만(무엇이 나와도 출고), enforce 라야 regenerate 판정이
# 실제 재시도로 이어진다. 예산(생성+2패스+재시도)이 공유되므로 enforce 를 켤 때는
# MANNEQUIN_MAX_ATTEMPTS 를 3 이상으로 — 2 면 생성1+2패스1 로 소진되어 재시도가 없다.
IMAGE_QC=off
MANNEQUIN_MAX_ATTEMPTS=2

# 상세페이지 컷 동시 생성 — 0=제한 없음(컷 수만큼 동시), 문제 시 숫자로 낮춘다(구 값 3).
# STAGGER_MS = i번째 컷을 i×간격(ms) 뒤에 제출해 순간 버스트 평탄화(13컷×3000ms=제출 20건/분).
# 429 는 클라이언트가 5s→10s 백오프로 2회 재시도한다(gemini_image.py).
DETAIL_CUT_CONCURRENCY=0
DETAIL_CUT_STAGGER_MS=3000
DETAIL_CUT_IMAGE_SIZE=1K
DETAIL_CUT_MAX_ATTEMPTS=2      # prod confirmed-GPT profile은 1(first result only)
# 빈 값이면 image_high 폴백. 프로덕션은 과거 선호 실험의 고정 GPT Image 2 스냅샷.
MODEL_ROUTING_DETAIL_CUT=
CUT_OUTPUT_QC_MODE=off
GARMENT_QC_MODE=bestof

# 편집 2패스 3종 — 각각 이미지 호출 1회를 쓰며 MANNEQUIN_MAX_ATTEMPTS 예산을 공유한다.
# 셋 다 켜면 최악(여성·패턴·매칭) 4회 소비 → MAX_ATTEMPTS 5 이상 권장.
MANNEQUIN_BUST_PASS=off      # 여성 가슴 볼륨
MANNEQUIN_FABRIC_PASS=off    # 미세 패턴 원단 재현
MANNEQUIN_UNTUCK_PASS=off    # 상의 밑단을 하의 밖으로 (top/outer + 매칭 첨부 시)
# untuck 사전 게이트 — 확신에 찬 "이미 빠져 있음"만 편집 스킵(비대칭·fail-open). off|on.
MANNEQUIN_UNTUCK_GATE=off
# 게이트 전용 판정 모델("" = 정본 텍스트 모델). 스킵률 관측 후 flash-lite 강등 실험용.
MANNEQUIN_UNTUCK_GATE_MODEL=
# 가슴 보정 사전 게이트 — 확신에 찬 "이미 볼륨 충분"만 보정 스킵(비대칭·fail-open). off|on.
MANNEQUIN_BUST_GATE=off
MANNEQUIN_BUST_GATE_MODEL=
# 로고·레터링·프린트 상품 출력 해상도 — 1K는 글자가 깨진다(A/B 8/19). 1K와 요금 동일. off|1K|2K|4K.
MANNEQUIN_LOGO_IMAGE_SIZE=2K
MANNEQUIN_PANTS_QC=off       # 매칭 하의 정체성 QC: off|shadow|enforce (매칭 첨부 시만, AI 콜 +0)

# 1패스 생성 tier. image_high=gemini-3-pro-image, image_light=gemini-3.1-flash-image.
MANNEQUIN_TIER=image_high
# 조정(:regenerate)만 다른 tier 로 보내는 노브. 빈 값이면 분기 없이 위 값을 쓴다.
# 조정과 초기 생성이 같은 워커를 타서, 이걸 안 쓰면 둘을 다른 모델로 못 돌린다.
# 편집 패스 3종은 여기 해당 없다 — 코드에서 image_high 고정(Flash 는 편집 거부·미반영 이력).
MANNEQUIN_ADJUST_TIER=       # "" | image_light | image_high

# ── SAM2 캐노니컬 컷아웃(선택) ───────────────────────────────────────────────
# 내부 세그멘테이션 서비스. 비워 두면 캐노니컬 전처리가 통째로 비활성화된다
# (sam_preprocess 잡은 skipped 로 종결, 마네킹 생성은 RAW 경로 그대로). 로컬에서 굳이
# 켤 이유는 없다 — torch + 가중치가 필요하고, 없다고 막히는 기능이 없다.
SAM_SERVICE_URL=              # 예: http://sam2:8080 (prod 는 Copilot Service Connect)
SAM_INTERNAL_TOKEN=           # 서비스 간 공유 시크릿. prod 는 SSM 이 주입한다.
SAM_REQUEST_TIMEOUT_S=90      # Front+Back 실측 ~49s(warm x86_64 Fargate) 위의 여유
# 마네킹컷 의류 영역 색감·밝기 조정. on 이면 생성 직후 편집용 마스크를 준비한다.
MANNEQUIN_TONE_EDITOR=on
# 커스텀 매칭 의류(내 옷) 배경 제거. on 이면 등록 커밋 뒤 무과금 matching_cutout 잡이
# 돌아 썸네일·생성입력을 시드 회색 배경 컷으로 교체한다. SAM 미설정이면 저절로 skip.
MATCHING_CUTOUT=off
# 누끼 성공본을 시드 카탈로그와 같은 정면 flat-lay 로 재렌더한다(카드 썸네일 1장).
# 무과금 잡 그대로지만 아이템당 이미지 호출이 1회 붙는다 — 실비는 image_usage_events
# 의 stage=matching_flatlay 로 잡힌다. 누끼가 실패/skip 이면 생성도 없다.
#   off  = 재렌더 없음
#   on   = 카드 썸네일만 교체
#   full = 썸네일 + **마네킹 생성 입력 grid 의 front 칸**까지 flat-lay 로 교체(호출 증가
#          없음, 이미 만든 1장 재사용). 접힌 채 찍힌 하의가 착장에서 실루엣을 잃는 문제의
#          해법이지만, 유료 생성의 입력이 모델 출력으로 바뀐다는 뜻이기도 하다.
MATCHING_FLATLAY=off
# flat-lay 재렌더 모델. 프롬프트는 스파이크 전략 B 고정, 모델만 고른다.
# 리포트는 정체성 동률·비용 절반·속도 2배로 flash 를 추천했고(실비 $0.068 vs $0.139),
# 기본을 pro 로 둔 것은 오너 판단이다. 비용을 줄이려면 image_light 로 내린다.
MATCHING_FLATLAY_TIER=image_high   # image_high(Gemini 3 Pro Image) | image_light(Flash)
