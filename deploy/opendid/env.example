# Copy the needed entries into the secret env files under /opt/opendid/secrets.
# Do not commit filled copies.

# /opt/opendid/secrets/TA/postgres.env
OPENDID_POSTGRES_DB=postgres
OPENDID_POSTGRES_USER=postgres
OPENDID_POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_SUPERUSER_PASSWORD

# /opt/opendid/secrets/TA/tas.env
OPENDID_DB_USER=omn
OPENDID_DB_PASSWORD=REPLACE_WITH_OPENDID_DB_PASSWORD
OPENDID_TAS_WALLET_PASSWORD=REPLACE_WITH_TAS_WALLET_PASSWORD

# /opt/opendid/secrets/Issuer/issuer.env
OPENDID_DB_USER=omn
OPENDID_DB_PASSWORD=REPLACE_WITH_OPENDID_DB_PASSWORD
OPENDID_ISSUER_WALLET_PASSWORD=REPLACE_WITH_ISSUER_WALLET_PASSWORD
OPENDID_ISSUER_ZKP_WALLET_PASSWORD=REPLACE_WITH_ISSUER_ZKP_WALLET_PASSWORD

# /opt/opendid/secrets/CA/cas.env
OPENDID_DB_USER=omn
OPENDID_DB_PASSWORD=REPLACE_WITH_OPENDID_DB_PASSWORD
OPENDID_CAS_WALLET_PASSWORD=REPLACE_WITH_CAS_WALLET_PASSWORD

# /opt/opendid/secrets/Wallet/fm-holder.env
FM_HOLDER_PEPPER=REPLACE_WITH_HOLDER_PEPPER
FM_WALLET_PROVIDER_PATH=/opt/opendid/secrets/Wallet/wallet.wallet
FM_WALLET_PROVIDER_PW=REPLACE_WITH_WALLET_PROVIDER_PASSWORD
FM_CAS_PROVIDER_PATH=/opt/opendid/secrets/CA/cas.wallet
FM_CAS_PROVIDER_PW=REPLACE_WITH_CAS_PROVIDER_PASSWORD
