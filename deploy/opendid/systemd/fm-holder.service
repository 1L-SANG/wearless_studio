[Unit]
Description=FaceMarket OpenDID Holder
Requires=opendid-tas.service opendid-issuer.service opendid-cas.service
After=network-online.target docker.service opendid-tas.service opendid-issuer.service opendid-cas.service

[Service]
Type=simple
User=opendid
Group=opendid
WorkingDirectory=/opt/opendid
Environment=JAVA_HOME=/usr/lib/jvm/java-21-openjdk
Environment=PATH=/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/opt/opendid/secrets/Wallet/fm-holder.env
ExecStart=java -jar /opt/opendid/jars/Holder/fm-holder-0.1.0.jar --server.port=8100 --spring.config.additional-location=file:/opt/opendid/config/holder.yml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
