# Vite 프론트 설정 — .env.local 로 복사해서 사용
# API 모드: mock(기본) | http — http 면 httpAdapter 에 구현된 함수만 실서버 사용 (plan §8)
VITE_API_MODE=mock
# http 모드의 FastAPI 베이스 URL
VITE_API_BASE_URL=https://api.wearless.kr
# 자산 capability rollout. backend privacy marker 배포·smoke 전에는 1, 이후 빌드만 2.
VITE_ASSET_CACHE_VERSION=1
# 배경-only 생성예시. 로컬 기본 false; production은 서버 게이트와 함께 명시적으로 활성화한다.
VITE_GENEXAMPLE_BG_ENABLED=false

# FaceMarket 등록 위저드에 노출할 본인인증 수단(콤마 분리). 기본 'mid'(모바일 신분증만,
# 현행 UX 그대로) — 서버 FM_IDENTITY_METHODS 와 같은 값으로 맞춘다. "mid,simple_auth" 로
# 켜려면 서버 FM_OACX_SIMPLE_AUTH_CONTRACT=simple-auth-v1 과 아래 CX_AUTH_CONFIG_URL 도 필요하다.
VITE_FM_IDENTITY_METHODS=mid,simple_auth
# 간편인증(ENT_SIMPLE_AUTH) 위젯 설정 URL. 비어 있으면 간편인증 버튼이 비활성화된다
# (설정 없이 위젯을 열면 조용히 실패하는 것을 막는 안전장치).
# 2026-09-13 실측: 별도 발급 없이 **기존 모바일신분증 config 로 간편인증 창이 뜬다** —
# sortCategory 를 ["mid"] 로 강제하는 분기가 ENT_MID 일 때만 걸리기 때문이다(스펙 §14.1).
# 토스 간편인증 실거래도 이 config 로 통과했다(§14.3). 그래서 같은 URL 을 명시한다.
VITE_CX_AUTH_CONFIG_URL=https://cx.raonsecure.co.kr:17543/ent/esign/config/config.mid.json

# 토스 클라이언트 키 (공개 값 — 브라우저 SDK 초기화용). 시크릿 키는 서버 전용이다.
# 자동결제(구독)는 별도 계약 MID(bill_wearlau5j)라 클라이언트 키가 따로 난다.
# 개발자센터 > API 키에서 MID 를 고른 뒤 '중간에 ck 가 있는' 키를 넣는다(gck 아님).
# MID 가 하나뿐이면 BILLING 쪽은 비워 둔다 — 일반결제 키로 떨어진다(src/lib/tossKeys.js).
VITE_TOSS_CLIENT_KEY=
VITE_TOSS_BILLING_CLIENT_KEY=

# Supabase 인증 (프론트는 인증만 직접 접근 — plan §1). 둘 다 공개 가능한 값.
# ⚠️ service_role 키·DATABASE_URL 은 프론트(VITE_*) 에 절대 넣지 말 것 — 번들에 노출됨.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 카카오 로그인(OpenID Connect 직접 로그인) ----
# Supabase 의 카카오 OAuth 는 scope 에 account_email 을 **하드코딩**해서 붙이는데(GoTrue
# provider/kakao.go), 우리 카카오 앱은 그 항목이 "권한 없음"(비즈앱 전환 + 추가기능 심사
# 3~5영업일)이라 인가 요청이 전부 KOE205 로 거절됐다. 그래서 카카오만 OIDC 로 직접
# 로그인한다. 경위·배포 순서: docs/runbooks/kakao-oidc-login.md
#
# 기본 OFF. 켜기 **전에** 서버(/v1/auth/kakao/token)가 배포돼 있고 카카오 콘솔에
# Redirect URI 4개가 등록돼 있어야 한다. 되돌리기는 이 값을 지우고 재배포(빌드타임 인라인).
VITE_KAKAO_OIDC_ENABLED=false
# 카카오 REST API 키(=client_id). 공개값이라 번들에 실려도 된다.
# 🔴 Supabase 대시보드 Kakao provider 의 client_id 와 **같은 값**이어야 한다
#    (GoTrue 가 id_token 의 aud 를 그 값과 대조한다 — token_oidc.go).
# ⚠️ 카카오 Client Secret 은 **절대 VITE_ 로 넣지 마라** — 번들에 평문으로 실린다.
#    code→id_token 교환은 서버(KAKAO_CLIENT_SECRET)가 한다.
VITE_KAKAO_REST_API_KEY=7b78ab8b674afa91063744476ab946e9
