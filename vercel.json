{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/terms",
      "has": [{ "type": "host", "value": "ai.wearless.kr" }],
      "destination": "https://wearless.kr/terms",
      "permanent": true
    },
    {
      "source": "/privacy",
      "has": [{ "type": "host", "value": "ai.wearless.kr" }],
      "destination": "https://wearless.kr/privacy",
      "permanent": true
    },
    {
      "source": "/refund",
      "has": [{ "type": "host", "value": "ai.wearless.kr" }],
      "destination": "https://wearless.kr/refund",
      "permanent": true
    },
    {
      "source": "/model-license-terms",
      "has": [{ "type": "host", "value": "ai.wearless.kr" }],
      "destination": "https://wearless.kr/model-license-terms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.wearless.kr" }],
      "destination": "/admin.html"
    },
    {
      "source": "/favicon.ico",
      "has": [{ "type": "host", "value": "facemarket.wearless.kr" }],
      "destination": "/assets/brand/facemarket-favicon.ico"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "facemarket.wearless.kr" }],
      "destination": "/facemarket.html"
    },
    { "source": "/(.*)", "destination": "/seller.html" }
  ]
}
