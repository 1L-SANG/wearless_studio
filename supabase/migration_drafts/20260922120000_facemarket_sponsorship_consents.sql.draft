-- 기존 적용 이력, 모델 프로필 컬럼, VC, 기존 동의는 수정하거나 백필하지 않아요.
begin;
do $$ begin
  raise exception 'DRAFT ONLY: 협찬 동의 설계 초안이며 적용할 수 없어요';
end $$;

create table public.fm_sponsorship_consent_events (
  id bigint generated always as identity primary key,
  user_id uuid not null,
  model_id uuid,
  actor_user_id uuid,
  consent_type text not null check (consent_type in (
    'sponsorship_participation',
    'sponsorship_profile_collection',
    'sponsorship_profile_disclosure',
    'sponsorship_shipping_collection',
    'sponsorship_shipping_disclosure'
  )),
  action text not null check (action in ('granted', 'withdrawn')),
  doc_version text not null check (length(doc_version) > 0),
  document_sha256 text not null check (document_sha256 ~ '^[0-9a-f]{64}$'),
  occurred_at timestamptz not null default now(),
  ip_address inet,
  screen_id text not null check (length(screen_id) > 0),
  reason text not null check (reason in (
    'model_toggle', 'model_choice', 'license_withdrawal', 'account_deletion'
  )),
  request_id uuid,
  recipient_id uuid,
  notice_snapshot jsonb not null check (jsonb_typeof(notice_snapshot) = 'object'),
  idempotency_key uuid not null,
  unique (user_id, idempotency_key, consent_type),
  check (
    (consent_type in ('sponsorship_shipping_collection', 'sponsorship_shipping_disclosure')
      and request_id is not null)
    or
    (consent_type not in ('sponsorship_shipping_collection', 'sponsorship_shipping_disclosure')
      and request_id is null)
  ),
  check (
    (consent_type = 'sponsorship_shipping_disclosure' and recipient_id is not null)
    or (consent_type <> 'sponsorship_shipping_disclosure' and recipient_id is null)
  ),
  check (reason not in ('license_withdrawal', 'account_deletion') or action = 'withdrawn'),
  check (reason in ('license_withdrawal', 'account_deletion')
    or (actor_user_id is not null and actor_user_id = user_id and ip_address is not null))
);

create index fm_sponsorship_consent_events_latest_idx
  on public.fm_sponsorship_consent_events (user_id, consent_type, request_id, id desc);

alter table public.fm_sponsorship_consent_events enable row level security;
revoke all on public.fm_sponsorship_consent_events from public, anon, authenticated;
grant select, insert on public.fm_sponsorship_consent_events to service_role;
grant usage, select on sequence public.fm_sponsorship_consent_events_id_seq to service_role;

-- 이용자 API는 인증된 서버를 거쳐서만 조회·추가해요. 업데이트로 과거 동의를 덮지 않아요.
-- 서버는 문서 해시와 고지본을 생성하며 클라이언트의 user_id·IP·동의 시각을 신뢰하지 않아요.
-- notice_snapshot에는 실제 셀러 상호, 목적, 항목명, 기간, 거부 효과를 담아요.
-- 주소·연락처·인스타 계정의 실제 값과 신분증·얼굴 정보는 증빙에 복제하지 않아요.
-- auth.users나 모델 삭제에 증빙이 자동 연쇄 삭제되지 않게 FK를 두지 않았어요.
-- 기간 만료·적법한 삭제 요구는 권한이 분리된 파기 작업이 수행하고 파기 영수증만 남겨요.
-- 요청 테이블 FK와 소유권 검증은 후속 요청 스키마가 확정된 새 마이그레이션에서 추가해요.
rollback;
